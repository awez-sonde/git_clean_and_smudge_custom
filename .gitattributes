# Sanitize on git add; restore on checkout. See README.md for setup.

*.yaml              filter=sanitize-secrets
*.yml               filter=sanitize-secrets
**/templates/*      filter=sanitize-secrets
**/manifests/*      filter=sanitize-secrets
**/deploy/*         filter=sanitize-secrets
**/openshift/*      filter=sanitize-secrets
*.txt               filter=sanitize-secrets
*.conf              filter=sanitize-secrets
*.config            filter=sanitize-secrets
*.ini               filter=sanitize-secrets
*.properties        filter=sanitize-secrets
*.env               filter=sanitize-secrets
*.json              filter=sanitize-secrets
*.toml              filter=sanitize-secrets

# Test fixtures contain intentional plaintext for round-trip tests
tests/fixtures/**                 -filter

# Never run the filter on sanitization config / learned cache
sanitization.json                 -filter
sanitization.json.example         -filter
sanitization.learned.json         -filter
local_secrets_map.json            -filter
local_secrets_map.json.example    -filter
local_secrets_learned.json        -filter
.env.mapping                      -filter
