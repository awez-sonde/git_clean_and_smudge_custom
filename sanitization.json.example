{
  "version": 2,
  "description": "Copy to sanitization.json (gitignored). Refresh subnets: python3 scripts/discover_sanitization.py --write",
  "salt": "change-me-to-a-random-string",
  "subnet_rules": [
    {
      "actual_cidr": "192.168.50.0/24",
      "dummy_cidr": "10.0.0.0/24",
      "comment": "Customer VLAN — any 192.168.50.x IP in YAML becomes 10.0.0.x in Git"
    }
  ],
  "email_domains": [
    {
      "actual_domains": [
        "customer-corp.example",
        "keystone.internal"
      ],
      "dummy_domain": "apps.example.com",
      "comment": "Route hosts and emails: app.customer-corp.example → app.apps.example.com"
    }
  ],
  "sensitive_fields": {
    "match_mode": "contains",
    "comment": "Built-in tight key rules apply; add key_substrings only for extra custom patterns.",
    "key_substrings": [],
    "keys": [],
    "dummy_prefix": "DUMMY_SEC_"
  },
  "auto_learn": true,
  "replacements": []
}
