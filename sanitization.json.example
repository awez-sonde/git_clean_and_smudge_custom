{
  "version": 2,
  "description": "Copy to sanitization.json (gitignored). Refresh subnets: python3 scripts/discover_sanitization.py --write",
  "salt": "change-me-to-a-random-string",
  "subnet_rules": [
    {
      "actual_cidr": "192.168.50.0/24",
      "dummy_cidr": "10.0.0.0/24",
      "comment": "Customer VLAN \u2014 any 192.168.50.x IP in YAML becomes 10.0.0.x in Git"
    }
  ],
  "email_domains": [
    {
      "actual_domains": [
        "customer-corp.example",
        "keystone.internal"
      ],
      "dummy_domain": "apps.example.com",
      "comment": "Route hosts and emails: app.customer-corp.example \u2192 app.apps.example.com"
    }
  ],
  "sensitive_fields": {
    "match_mode": "contains",
    "comment": "Any KEY name containing these words (case-insensitive) is sanitized. Remove words here if too broad for your repo.",
    "key_substrings": [
      "password",
      "passwd",
      "pwd",
      "passphrase",
      "htpasswd",
      "secret",
      "token",
      "credential",
      "bearer",
      "jwt",
      "oauth",
      "apikey",
      "api_key",
      "accesskey",
      "access_key",
      "secretkey",
      "secret_key",
      "privatekey",
      "private_key",
      "privkey",
      "clientsecret",
      "client_secret",
      "admin",
      "user",
      "ldap",
      "bind",
      "auth",
      "registry",
      "pullsecret",
      "pull_secret",
      "dockerconfig",
      "keystore",
      "truststore",
      "sshkey",
      "ssh_key",
      "signing",
      "encryption",
      "salt",
      "certificate",
      "cacert",
      "ca_cert",
      "tls",
      "connstring",
      "connectionstring",
      "connection_string",
      "license"
    ],
    "keys": [],
    "dummy_prefix": "DUMMY_SEC_"
  },
  "auto_learn": true,
  "replacements": []
}
