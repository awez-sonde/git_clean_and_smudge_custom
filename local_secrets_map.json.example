{
  "version": 2,
  "description": "Copy to local_secrets_map.json (gitignored). Works with YAML (OpenShift/K8s), .conf, .env, JSON, etc.",
  "salt": "change-me-to-a-random-string",

  "subnet_rules": [
    {
      "actual_cidr": "192.168.50.0/24",
      "dummy_cidr": "10.0.0.0/24",
      "comment": "Customer VLAN — any 192.168.50.x IP in YAML becomes 10.0.0.x in Git"
    }
  ],

  "email_domains": [
    {
      "actual_domains": ["customer-corp.example"],
      "dummy_domain": "apps.example.com",
      "comment": "Route hosts and emails: app.customer-corp.example → app.apps.example.com"
    }
  ],

  "sensitive_fields": {
    "keys": [
      "password",
      "passwd",
      "secret",
      "api_key",
      "token",
      "username",
      "user",
      "client-secret",
      "bind-password",
      "htpasswd"
    ],
    "dummy_prefix": "DUMMY_SEC_"
  },

  "auto_learn": true,

  "replacements": []
}
